# Supabase (crear en supabase.com → settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string (Supabase → Settings → Database → Connection pooling → Transaction)
DATABASE_URL=

# Resend (resend.com → API keys)
RESEND_API_KEY=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Web Push (generar con: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:laura@epikom.com

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=
